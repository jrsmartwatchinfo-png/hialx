# PROVIDER=api  -> Google AI Studio API দিয়ে Gemma (সহজ, কম্পিউটারে ভারী কিছু লাগে না)
# PROVIDER=local -> Hugging Face থেকে মডেল নামিয়ে নিজের পিসিতে চালানো (GPU/বেশি RAM ভালো)
PROVIDER=api

# https://aistudio.google.com/apikey থেকে বিনামূল্যে key নিন
GOOGLE_API_KEY=এখানে_আপনার_key_বসান
GEMMA_API_MODEL=gemma-3-27b-it

# local মোডের জন্য (Hugging Face এ লাইসেন্স accept করে HF_TOKEN দিতে হবে)
GEMMA_LOCAL_MODEL=google/gemma-3-1b-it
HF_TOKEN=

SYSTEM_PROMPT=তুমি একজন বন্ধুসুলভ সহকারী। ব্যবহারকারী যে ভাষায় লেখে সেই ভাষাতেই উত্তর দাও।
